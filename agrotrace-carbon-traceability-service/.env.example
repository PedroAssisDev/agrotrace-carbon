PROV_SERVICE_NAME=agrotrace-carbon-provenance-service
PROV_ENVIRONMENT=local
PROV_LOG_LEVEL=INFO
PROV_API_HOST=0.0.0.0
PROV_API_PORT=8080
PROV_API_ROOT_PATH=
# SQLite-first (official phase). Run: python scripts/init_local_db.py
PROV_DATABASE_URL=sqlite:///./data/provenance.db
PROV_DATABASE_POOL_SIZE=10
PROV_DATABASE_MAX_OVERFLOW=20
PROV_DATABASE_ECHO=false
PROV_OUTBOX_POLL_INTERVAL_SECONDS=5
PROV_OUTBOX_BATCH_SIZE=100
PROV_HASH_DEFAULT_ALGORITHM=sha256
PROV_ONTOLOGY_CLIENT_BASE_URL=
PROV_BLOCKCHAIN_CLIENT_NETWORK=stub
PROV_WRAPPER_METADATA_CLIENT_BASE_URL=
