<owl:Class rdf:about="#CalculationResult">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#EmissionResult">
  <rdfs:subClassOf rdf:resource="#CalculationResult"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#calculatesGas"/>
      <owl:someValuesFrom rdf:resource="#GreenhouseGas"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#calculatesEmissionSource"/>
      <owl:someValuesFrom rdf:resource="#EmissionSource"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasNumericResult"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasResultUnit"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#CH4EmissionResult">
  <rdfs:subClassOf rdf:resource="#EmissionResult"/>
</owl:Class>

<owl:Class rdf:about="#N2OEmissionResult">
  <rdfs:subClassOf rdf:resource="#EmissionResult"/>
</owl:Class>

<owl:Class rdf:about="#CO2EmissionResult">
  <rdfs:subClassOf rdf:resource="#EmissionResult"/>
</owl:Class>

<owl:Class rdf:about="#CO2EquivalentResult">
  <rdfs:subClassOf rdf:resource="#EmissionResult"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#usesGWPParameterSet"/>
      <owl:someValuesFrom rdf:resource="#GWPParameterSet"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

