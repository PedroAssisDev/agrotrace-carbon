    rdfs:label "Kilogram N2O"^^xsd:string ;
    :hasCanonicalName "kg_n2o"^^xsd:string .

:unit_kg_per_day a :Unit,
        owl:NamedIndividual ;
    rdfs:label "Kilogram per day"^^xsd:string ;
    :hasCanonicalName "kg_per_day"^^xsd:string .

:unit_kg_per_month a :Unit,
        owl:NamedIndividual ;
    rdfs:label "Kilogram per month"^^xsd:string ;
    :hasCanonicalName "kg_per_month"^^xsd:string .

:unit_liter a :Unit,
        owl:NamedIndividual ;
    rdfs:label "Liter"^^xsd:string ;
    :hasCanonicalName "liter"^^xsd:string .

:usesCanonicalVariable a owl:ObjectProperty ;
    rdfs:domain :CalculationInput,
        :CalculationMethod ;
    rdfs:range :CanonicalVariable .

:usesEmissionFactor a owl:ObjectProperty ;
    rdfs:domain :CalculationExecution,
        :CalculationMethod ;
    rdfs:range :EmissionFactor .

:usesObservation a owl:ObjectProperty ;
    rdfs:domain :CalculationExecution,
        :CalculationInput ;
    rdfs:range :Observation .

