@prefix : <http://example.org/agromrv-lite#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/agromrv-lite> a owl:Ontology .

:BatchCalculationExecution a owl:Class ;
    rdfs:subClassOf :CalculationExecution .

:CH4EmissionResult a owl:Class ;
    rdfs:subClassOf :EmissionResult .

:CO2EmissionResult a owl:Class ;
    rdfs:subClassOf :EmissionResult .

:ConversionCalculationExecution a owl:Class ;
    rdfs:subClassOf :CalculationExecution .

:ConvertedInput a owl:Class ;
    rdfs:subClassOf :CalculationInput .

:DMIResult a owl:Class ;
    rdfs:subClassOf :CalculationResult .

:DestinationObservation a owl:Class ;
    rdfs:subClassOf :QualitativeObservation .

:EmissionCalculationExecution a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :generatesCalculationResult ;
            owl:someValuesFrom :EmissionResult ],
        :CalculationExecution .

:EmissionFactorInput a owl:Class ;
    rdfs:subClassOf :CalculationInput .

:FertilizerUseObservation a owl:Class ;
    rdfs:subClassOf :QuantitativeObservation .

:GWPInput a owl:Class ;
    rdfs:subClassOf :CalculationInput .

:LegacyCompatibilityExecution a owl:Class ;
    rdfs:subClassOf :CalculationExecution .

:Location a owl:Class ;
    rdfs:subClassOf :FarmEntity .

:N2OEmissionResult a owl:Class ;
    rdfs:subClassOf :EmissionResult .

:ObservationInput a owl:Class ;
    rdfs:subClassOf :CalculationInput .

:ParameterInput a owl:Class ;
    rdfs:subClassOf :CalculationInput .

:ProductivityResult a owl:Class ;
    rdfs:subClassOf :CalculationResult .

:ResponsiblePersonObservation a owl:Class ;
    rdfs:subClassOf :QualitativeObservation .

:belongsToRecord a owl:ObjectProperty ;
    rdfs:domain :Observation ;
    rdfs:range :DataRecord .

:convertsFromGranularity a owl:ObjectProperty ;
    rdfs:domain :ConversionCalculationMethod ;
    rdfs:range :TemporalContext .

:convertsToGranularity a owl:ObjectProperty ;
    rdfs:domain :ConversionCalculationMethod ;
    rdfs:range :TemporalContext .

:hasAggregationStrategy a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasCalculationInput a owl:ObjectProperty ;
    rdfs:domain :CalculationExecution ;
    rdfs:range :CalculationInput .

:hasCalculationVersion a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasCanonicalName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasCompatibilityMode a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasDate a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasDisplayName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasEndDate a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasExpectedUnit a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasFormulaExpression a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasFunctionName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasGWP_CH4 a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

:hasGWP_CO2 a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

:hasGWP_N2O a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

:hasIdentifier a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasInformationResponsible a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasLocationName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasMethodDescription a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasModulePath a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasObservation a owl:ObjectProperty ;
    rdfs:domain :DataRecord ;
    rdfs:range :Observation .

:hasOrganizationalGranularity a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasOriginalColumnName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasOwnerName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasParameterName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasParameterValue a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

:hasPartialResult a owl:ObjectProperty ;
    rdfs:domain :AggregatedResult,
        :TotalGHGCO2eCalculationMethod ;
    rdfs:range :CalculationResult .

:hasPropertyName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasRecordType a owl:ObjectProperty ;
    rdfs:domain :DataRecord ;
    rdfs:range owl:Thing .

:hasSourceLayout a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasStartDate a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasTemporalGranularity a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasTemporalType a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasTotalResult a owl:ObjectProperty ;
    rdfs:domain :AggregatedResult,
        :CalculationExecution ;
    rdfs:range :CalculationResult .

:hasYear a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:implementedByFunction a owl:ObjectProperty ;
    rdfs:domain :CalculationMethod ;
    rdfs:range :SoftwareFunction .

:implementedInSoftwareComponent a owl:ObjectProperty ;
    rdfs:domain :CalculationMethod,
        :SoftwareFunction ;
    rdfs:range :SoftwareComponent .

:method_batch_runner a :BatchCalculationRunner,
        owl:NamedIndividual ;
    rdfs:label "batch_runner"^^xsd:string ;
    :hasFunctionName "compute_row_results"^^xsd:string ;
    :hasModulePath "batch_runner.py"^^xsd:string ;
    :hasResultUnit "dimensionless"^^xsd:string ;
    :implementedByFunction :fn_compute_row_results ;
    :implementedInSoftwareComponent :sw_batch_runner_component .

:method_calculate_energy_co2 a :EnergyCO2CalculationMethod,
        owl:NamedIndividual ;
    rdfs:label "calculate_energy_co2"^^xsd:string ;
    :calculatesEmissionSource :source_energy_use ;
    :calculatesGas :gas_carbon_dioxide ;
    :hasFunctionName "calculate_energy_co2"^^xsd:string ;
    :hasModulePath "emissions/energy.py"^^xsd:string ;
    :hasResultUnit "kg_co2"^^xsd:string ;
    :implementedByFunction :fn_calculate_energy_co2 ;
    :implementedInSoftwareComponent :sw_energy_component ;
    :requiresInputVariable :var_diesel,
        :var_electricity_grid,
        :var_gasoline,
        :var_other_fuel,
        :var_photovoltaic_energy .

:method_calculate_enteric_fermentation_ch4 a :EntericFermentationCH4CalculationMethod,
        owl:NamedIndividual ;
    rdfs:label "calculate_enteric_fermentation_ch4"^^xsd:string ;
    :calculatesEmissionSource :source_enteric_fermentation ;
    :calculatesGas :gas_methane ;
    :hasFunctionName "calculate_enteric_fermentation_ch4"^^xsd:string ;
    :hasModulePath "emissions/enteric_fermentation.py"^^xsd:string ;
    :hasResultUnit "kg_ch4"^^xsd:string ;
    :implementedByFunction :fn_calculate_enteric_fermentation_ch4 ;
    :implementedInSoftwareComponent :sw_enteric_fermentation_component ;
    :requiresInputVariable :var_bulls,
        :var_calves,
        :var_dry_cows,
        :var_ef_enteric_kg_ch4,
        :var_lactating_cows .

:method_calculate_fertilizer_n2o a :FertilizerN2OCalculationMethod,
        owl:NamedIndividual ;
    rdfs:label "calculate_fertilizer_n2o"^^xsd:string ;
    :calculatesEmissionSource :source_fertilizer_application ;
    :calculatesGas :gas_nitrous_oxide ;
    :hasFunctionName "calculate_fertilizer_n2o"^^xsd:string ;
    :hasModulePath "emissions/fertilizer.py"^^xsd:string ;
    :hasResultUnit "kg_n2o"^^xsd:string ;
    :implementedByFunction :fn_calculate_fertilizer_n2o ;
    :implementedInSoftwareComponent :sw_fertilizer_component ;
    :requiresInputVariable :var_non_organic_fertilizer,
        :var_organic_fertilizer .

:method_calculate_manure_management_ch4 a :ManureManagementCH4CalculationMethod,
        owl:NamedIndividual ;
    rdfs:label "calculate_manure_management_ch4"^^xsd:string ;
    :calculatesEmissionSource :source_manure_management ;
    :calculatesGas :gas_methane ;
    :hasFunctionName "calculate_manure_management_ch4"^^xsd:string ;
    :hasModulePath "emissions/manure_management.py"^^xsd:string ;
    :hasResultUnit "kg_ch4"^^xsd:string ;
    :implementedByFunction :fn_calculate_manure_management_ch4 ;
    :implementedInSoftwareComponent :sw_manure_management_component ;
    :requiresInputVariable :var_calves,
        :var_dry_cows,
        :var_heifers,
        :var_lactating_cows .

:method_calculate_total_ghg_co2e a :TotalGHGCO2eCalculationMethod,
        owl:NamedIndividual ;
    rdfs:label "calculate_total_ghg_co2e"^^xsd:string ;
    :calculatesEmissionSource :source_total_ghg ;
    :hasFunctionName "calculate_total_ghg_co2e"^^xsd:string ;
    :hasModulePath "emissions/ghg_total.py"^^xsd:string ;
    :hasResultUnit "kg_co2e"^^xsd:string ;
    :implementedByFunction :fn_calculate_total_ghg_co2e ;
    :implementedInSoftwareComponent :sw_ghg_total_component ;
    :requiresGWPParameterSet true ;
    :usesGWPParameterSet :gwp_gwp_set_example_2026 .

:method_environmental_calcs_adapter a :LegacyCompatibilityAdapter,
        owl:NamedIndividual ;
    rdfs:label "environmental_calcs_adapter"^^xsd:string ;
    :hasCompatibilityMode "legacy"^^xsd:string ;
    :hasFunctionName "calculate_total_emissions"^^xsd:string ;
    :hasModulePath "environmental_calcs.py"^^xsd:string ;
    :hasResultUnit "dimensionless"^^xsd:string ;
    :implementedByFunction :fn_calculate_total_emissions ;
    :implementedInSoftwareComponent :sw_environmental_calcs_adapter .

:method_legacy_default_configuration_provider a :DefaultConfigurationProvider,
        owl:NamedIndividual ;
    rdfs:label "legacy_default_configuration_provider"^^xsd:string ;
    :hasFunctionName "default_enteric_ch4_kg_per_animal_yearly"^^xsd:string ;
    :hasModulePath "emissions/defaults.py"^^xsd:string ;
    :hasResultUnit "dimensionless"^^xsd:string ;
    :implementedByFunction :fn_default_enteric_ch4_kg_per_animal_yearly ;
    :implementedInSoftwareComponent :sw_defaults_component .

:method_monthly_to_annual_proration a :MonthlyToAnnualProrationMethod,
        owl:NamedIndividual ;
    rdfs:label "monthly_to_annual_proration"^^xsd:string ;
    :hasFunctionName "uniform_monthly_from_yearly_per_animal"^^xsd:string ;
    :hasModulePath "emissions/conversion_helpers.py"^^xsd:string ;
    :hasResultUnit "dimensionless"^^xsd:string ;
    :implementedByFunction :fn_uniform_monthly_from_yearly_per_animal ;
    :implementedInSoftwareComponent :sw_conversion_helpers_component .

:method_monthly_to_annual_sum a :MonthlyToAnnualSumMethod,
        owl:NamedIndividual ;
    rdfs:label "monthly_to_annual_sum"^^xsd:string ;
    :hasFunctionName "sum_monthly_values"^^xsd:string ;
    :hasModulePath "emissions/conversion_helpers.py"^^xsd:string ;
    :hasResultUnit "dimensionless"^^xsd:string ;
    :implementedByFunction :fn_sum_monthly_values ;
    :implementedInSoftwareComponent :sw_conversion_helpers_component .

:refersToAnimal a owl:ObjectProperty ;
    rdfs:domain :DataRecord,
        :Observation ;
    rdfs:range :Animal .

:refersToProperty a owl:ObjectProperty ;
    rdfs:domain :DataRecord,
        :Observation ;
    rdfs:range :Property .

:requiresGWPParameterSet a owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

:requiresInputVariable a owl:ObjectProperty ;
    rdfs:domain :CalculationMethod ;
    rdfs:range :CanonicalVariable .

:unit_dimensionless a :Unit,
        owl:NamedIndividual ;
    rdfs:label "Dimensionless"^^xsd:string ;
    :hasCanonicalName "dimensionless"^^xsd:string .

:unit_kg_ch4 a :Unit,
        owl:NamedIndividual ;
