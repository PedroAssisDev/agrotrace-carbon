:QuantitativeObservation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasNumericValue ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty :hasUnit ;
            owl:someValuesFrom :Unit ],
        :Observation .

