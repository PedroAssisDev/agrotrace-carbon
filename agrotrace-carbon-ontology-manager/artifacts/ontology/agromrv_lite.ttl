:GreenhouseGas a owl:Class ;
    rdfs:subClassOf owl:Thing .

:MilkVariable a owl:Class ;
    rdfs:subClassOf :CanonicalVariable .

:OrganizationalContext a owl:Class ;
    rdfs:subClassOf :Context .

:animal_a123 a :Animal,
        owl:NamedIndividual ;
    :hasIdentifier "A123"^^xsd:string .

:time_day_2026_01_15 a :TemporalContext,
        owl:NamedIndividual ;
    :hasDate "2026-01-15"^^xsd:string ;
    :hasTemporalGranularity "day"^^xsd:string ;
    :hasTemporalType "instant"^^xsd:string .

:WeightVariable a owl:Class ;
    rdfs:subClassOf :CanonicalVariable .

:AdministrativeVariable a owl:Class ;
    rdfs:subClassOf :CanonicalVariable .

:EmissionCalculationMethod a owl:Class ;
    rdfs:subClassOf :CalculationMethod .

:EmissionSource a owl:Class ;
    rdfs:subClassOf owl:Thing .

:CalculationInput a owl:Class ;
    rdfs:subClassOf owl:Thing .

:CalculationResult a owl:Class ;
    rdfs:subClassOf owl:Thing .

:EmissionResult a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasNumericResult ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty :hasResultUnit ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty :calculatesGas ;
            owl:someValuesFrom :GreenhouseGas ],
        [ a owl:Restriction ;
            owl:onProperty :calculatesEmissionSource ;
            owl:someValuesFrom :EmissionSource ],
        :CalculationResult .

:HerdCountObservation a owl:Class ;
    rdfs:subClassOf :QuantitativeObservation .

:TemporalContext a owl:Class ;
    rdfs:subClassOf :Context .

:Observation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasOrganizationalContext ;
            owl:someValuesFrom :OrganizationalContext ],
        [ a owl:Restriction ;
            owl:onProperty :hasTemporalContext ;
            owl:someValuesFrom :TemporalContext ],
        [ a owl:Restriction ;
            owl:onProperty :observesVariable ;
            owl:someValuesFrom :CanonicalVariable ],
        owl:Thing .

:unit_head a :Unit,
        owl:NamedIndividual ;
    rdfs:label "Head (animals)"^^xsd:string ;
    :hasCanonicalName "head"^^xsd:string .

:DataRecord a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasTemporalContext ;
            owl:someValuesFrom :TemporalContext ],
        [ a owl:Restriction ;
            owl:onProperty :hasOrganizationalContext ;
            owl:someValuesFrom :OrganizationalContext ],
        owl:Thing .

:CalculationMethod a owl:Class ;
    rdfs:subClassOf :CalculationEntity .

:SoftwareFunction a owl:Class ;
    rdfs:subClassOf :SoftwareComponent .

:CalculationExecution a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasOrganizationalContext ;
            owl:someValuesFrom :OrganizationalContext ],
        [ a owl:Restriction ;
            owl:onProperty :hasCalculationMethod ;
            owl:someValuesFrom :CalculationMethod ],
        [ a owl:Restriction ;
            owl:onProperty :hasTemporalContext ;
            owl:someValuesFrom :TemporalContext ],
        :CalculationEntity .

:SoftwareComponent a owl:Class ;
    rdfs:subClassOf owl:Thing .

