:NutritionVariable a owl:Class ;
    rdfs:subClassOf :CanonicalVariable .

:hasOrganizationalContext a owl:ObjectProperty ;
    rdfs:domain :CalculationExecution,
        :Context,
        :DataRecord,
        :Observation ;
    rdfs:range :OrganizationalContext .

:hasTemporalContext a owl:ObjectProperty ;
    rdfs:domain :CalculationExecution,
        :Context,
        :DataRecord,
        :Observation ;
    rdfs:range :TemporalContext .

