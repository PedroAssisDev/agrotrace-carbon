:Context a owl:Class ;
    rdfs:subClassOf owl:Thing .

:ConversionCalculationMethod a owl:Class ;
    rdfs:subClassOf :CalculationMethod .

:EmissionVariable a owl:Class ;
    rdfs:subClassOf :CanonicalVariable .

:QualitativeObservation a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasTextValue ;
            owl:someValuesFrom xsd:string ],
        :Observation .

